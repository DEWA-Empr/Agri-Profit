# AGRI-PROFIT — environment configuration template
#
# Copy to `.env` and fill in. `.env` is gitignored and must never be committed.
# Every value below is read by backend/app/core/config.py; anything left unset
# falls back to the development default in that file.
#
#   cp .env.example .env
#
# THE ONLY VALUE THAT WILL STOP THE APPLICATION BOOTING IS SECRET_KEY. Outside
# dev/test the app refuses to start on the public default rather than silently
# signing forgeable tokens with a key that is printed in this repository.

# --- Environment ----------------------------------------------------------
# "dev" | "test" | "production". Anything other than dev/test enforces the
# SECRET_KEY guard below.
ENVIRONMENT=production

# --- Secrets --------------------------------------------------------------
# JWT signing key. Generate a fresh one per deployment and never reuse the value
# from another environment:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
SECRET_KEY=

# --- Database -------------------------------------------------------------
# Full SQLAlchemy URL. Use a dedicated role that owns only this database — not
# the postgres superuser — and a password generated the same way as SECRET_KEY.
#
#   postgresql://agriprofit:<password>@db:5432/agriprofit
#
DATABASE_URL=

# Consumed by the postgres container in docker-compose.prod.yml. POSTGRES_PASSWORD
# must match the password inside DATABASE_URL above.
POSTGRES_USER=agriprofit
POSTGRES_PASSWORD=
POSTGRES_DB=agriprofit

# --- Web ------------------------------------------------------------------
# JSON array of origins permitted to call the API. Must be the exact scheme and
# host the frontend is served from — a trailing slash or an http/https mismatch
# is the usual cause of "works locally, CORS error in production".
CORS_ORIGINS=["https://agriprofit.example.edu"]

# Where the browser should send API calls. Baked into the bundle at BUILD time
# (Vite inlines it), so changing it means rebuilding the frontend image.
# "/api/v1" is same-origin and is what the bundled Caddy edge serves: no CORS
# preflight, and the service worker can cache API reads cleanly.
VITE_API_URL=/api/v1

# Public hostname, only used by the optional `edge` profile (Caddy). Leave unset
# if your institution terminates TLS in front of this stack.
CADDY_DOMAIN=agriprofit.example.edu

# Believe X-Forwarded-For when identifying a caller for rate limiting.
# Set to true ONLY when a reverse proxy you control always overwrites that
# header. With no proxy in front, a client can send it itself and rotate through
# fake addresses to defeat every per-IP limit. See docs/OPERATIONS.md.
TRUST_PROXY_HEADERS=true

# --- Sessions -------------------------------------------------------------
# Access-token lifetime in minutes. Default 1440 (24h).
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Investor share links -------------------------------------------------
# Default lifetime, in days, for a newly minted share link when the farmer names
# none. Callers may request 1-365. Links minted before expiry existed never
# lapse and are unaffected by this value.
SHARE_LINK_DEFAULT_TTL_DAYS=90

# --- Rate limiting --------------------------------------------------------
# In-process counters; see backend/app/core/rate_limit.py for what that does and
# does not cover. Set RATE_LIMIT_ENABLED=false only to diagnose a lockout.
RATE_LIMIT_ENABLED=true
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=900
LOGIN_IP_MAX_ATTEMPTS=30
REGISTER_MAX_ATTEMPTS=20
REGISTER_WINDOW_SECONDS=3600
SHARE_REPORT_MAX_ATTEMPTS=60
SHARE_REPORT_WINDOW_SECONDS=300
