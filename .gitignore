# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg
*.egg-info/
dist/
build/
.eggs/
venv/
.venv/
env/
*.env
.env.*
# ...but the TEMPLATE is documentation, not a secret, and is the only record of
# which variables a deployment must set. It holds names and comments, never
# values. Keep this negation below the patterns above or git ignores it.
!.env.example

# Database
*.db
*.sqlite3

# Node / frontend
node_modules/
dist/
.next/
.nuxt/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Docker volumes (local mounts)
postgres_data/

# ML models + generated training data (regenerated from ml/dataset.py)
backend/app/ml/models/
backend/app/ml/data/

# Test cache
.pytest_cache/
.coverage
htmlcov/

# Claude Code local settings (personal overrides)
.claude/settings.local.json

# Local design-review screenshots (generated, not source)
screenshots/

# Documents (write-ups / exports — not source)
*.docx

# Generated standalone HTML export
AgriProfit-standalone.html

# Local DB backup taken before the auth migration (do not commit)
backup_pre_auth_migration.sql
backup_pre_share_migration.sql

# Another tool's config directory (empty placeholder files)
.gemini/
