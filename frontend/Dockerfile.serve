# Production image: a static build served by nginx.
#
# WHY THIS EXISTS ALONGSIDE Dockerfile.prod. `Dockerfile.prod` serves the build
# with `vite preview`, which Vite's own documentation describes as a preview of
# the production build for local testing — not a production server. It is kept
# UNCHANGED because it is the container the Chapter 4 performance figures were
# measured against, and rewriting it would invalidate a reported measurement to
# gain nothing the thesis needs. This file is the one to deploy.
#
# Two stages so the runtime image carries no node_modules and no toolchain:
# roughly 50 MB of nginx and static assets instead of ~1 GB of Node.

FROM node:20-slim AS build
WORKDIR /app

COPY package*.json ./
# `npm ci`, not `npm install`: it installs exactly the lockfile and fails if
# package.json and the lock disagree, which is what makes a build reproducible.
RUN npm ci

COPY . .
# Inlined into the bundle at build time — Vite substitutes it statically, so it
# is a build argument rather than a runtime environment variable.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine AS serve
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Unprivileged: nginx:alpine can run as non-root on a high port, and there is no
# reason for a static file server to be root inside its own container.
EXPOSE 8080
USER nginx
CMD ["nginx", "-g", "daemon off;"]
