# Production image: a static build served by nginx.
#
# WHY THIS EXISTS ALONGSIDE Dockerfile.prod. `Dockerfile.prod` serves the build
# with `vite preview`, which Vite's own documentation describes as a preview of
# the production build for local testing — not a production server. It is kept
# UNCHANGED because it is the container the Chapter 4 performance figures were
# measured against, and rewriting it would invalidate a reported measurement to
# gain nothing the thesis needs. This file is the one to deploy.
#
# Two stages so the runtime image carries no node_modules and no toolchain:
# roughly 50 MB of nginx and static assets instead of ~1 GB of Node.

FROM node:20-slim AS build
WORKDIR /app

COPY package*.json ./
# `npm ci`, not `npm install`: it installs exactly the lockfile and fails if
# package.json and the lock disagree, which is what makes a build reproducible.
RUN npm ci

COPY . .
# Inlined into the bundle at build time — Vite substitutes it statically, so it
# is a build argument rather than a runtime environment variable.
ARG VITE_API_URL=/api/v1
ENV VITE_API_URL=$VITE_API_URL
RUN npm run build

FROM nginx:1.27-alpine AS serve
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf

# Unprivileged: nginx:alpine can run as non-root on a high port, and there is no
# reason for a static file server to be root inside its own container.
#
# THE USER DIRECTIVE ALONE WAS NOT ENOUGH, and the gap was invisible until the
# image was actually run. Stock nginx keeps its scratch space under
# /var/cache/nginx and its pid at /var/run/nginx.pid, both root-owned in the
# base image, and it creates the temp directories at startup rather than on
# first use. So `USER nginx` produced
#
#   [emerg] mkdir() "/var/cache/nginx/client_temp" failed (13: Permission denied)
#
# on every start, and the container crash-looped. Nothing caught it: the
# healthcheck never got a chance to run, and no test or CI job had ever started
# this image. Handing the user its own scratch space and pid file is the whole
# fix; the application content under /usr/share/nginx/html stays root-owned and
# read-only to the server, which is what it should be.
RUN mkdir -p /var/cache/nginx/client_temp /var/cache/nginx/proxy_temp              /var/cache/nginx/fastcgi_temp /var/cache/nginx/uwsgi_temp              /var/cache/nginx/scgi_temp  && chown -R nginx:nginx /var/cache/nginx  && touch /var/run/nginx.pid  && chown nginx:nginx /var/run/nginx.pid

EXPOSE 8080
USER nginx
CMD ["nginx", "-g", "daemon off;"]
